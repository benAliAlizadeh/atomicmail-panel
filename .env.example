# Server
HOST=127.0.0.1
PORT=8787
DATA_DIR=./data
DB_PATH=./data/atomicmail-panel.sqlite

# Optional admin authentication.
# Leave ADMIN_PASSWORD empty only when the panel is strictly loopback/private.
# Set a 12+ character password before exposing the panel beyond localhost.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_TTL_MS=43200000
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_MS=900000
# Set true only when the browser reaches the panel over HTTPS.
ADMIN_COOKIE_SECURE=false

# Batch safety
MAX_BATCH_SIZE=100
USERNAME_MIN_LENGTH=10
USERNAME_MAX_LENGTH=14
EXPORT_MAX_ROWS=50000

# Worker safety: intentionally sequential
WORKER_ENABLED=true
WORKER_POLL_MS=1000
POST_SUCCESS_DELAY_MS=5000
MAX_RETRIES=3
RETRY_BASE_MS=15000
RETRY_MAX_MS=300000
RATE_LIMIT_COOLDOWN_MS=300000
TRANSIENT_CIRCUIT_THRESHOLD=5
TRANSIENT_CIRCUIT_COOLDOWN_MS=600000

# Webmail / JMAP
# Each request uses the encrypted mailbox credential vault, materializes it only
# in the OS temp directory while the official AgentSkill CLI runs, then re-seals it.
MAIL_COMMAND_TIMEOUT_MS=60000
MAIL_INBOX_LIMIT=50
MAIL_AUTO_REFRESH_SECONDS=45
MAIL_MAX_BODY_BYTES=524288
MAIL_MAX_COMPOSE_BYTES=204800
MAIL_MAX_SUBJECT_BYTES=2048
MAIL_MAX_SEARCH_BYTES=256
MAIL_MAX_ATTACHMENT_COUNT=5
MAIL_MAX_ATTACHMENT_BYTES=5242880
MAIL_MAX_TOTAL_ATTACHMENT_BYTES=10485760

# Optional destination-account password values are encrypted with the data key.
DESTINATION_PASSWORD_MAX_BYTES=1024

# Registration process. Atomic Mail says signup PoW is intentionally expensive,
# so this timeout is deliberately generous.
REGISTER_TIMEOUT_MS=180000
SHUTDOWN_GRACE_MS=15000

# Atomic Mail registration behavior
# This panel does not run an inbox watcher, so on-demand is the appropriate default.
ATOMICMAIL_WATCH_MODE=on-demand

# Atomic Mail endpoints
ATOMICMAIL_AUTH_URL=https://auth.atomicmail.ai
ATOMICMAIL_API_URL=https://api.atomicmail.ai

# Default uses the pinned AgentSkill through npx.
ATOMICMAIL_CLI_COMMAND=npx
ATOMICMAIL_CLI_PREFIX_ARGS_JSON=["-y","--package=@atomicmail/agent-skill@0.3.26","atomicmail"]

# If you install the CLI globally, use instead:
# ATOMICMAIL_CLI_COMMAND=atomicmail
# ATOMICMAIL_CLI_PREFIX_ARGS_JSON=[]

# Data safety / portability
# The panel encrypts permanent Atomic Mail credential files with AES-256-GCM.
# By default it creates ./secrets/data.key on first start. Back this key up
# separately from data/ and backups/. Losing it means the inbox API keys and
# encrypted backups cannot be recovered.
SECRETS_DIR=./secrets
DATA_ENCRYPTION_KEY_FILE=./secrets/data.key
# Optional alternative to key file: exactly 32 bytes as base64 or 64 hex chars.
# DATA_ENCRYPTION_KEY=

# Encrypted automatic backups
BACKUP_DIR=./backups
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_INTERVAL_MINUTES=360
BACKUP_MIN_GAP_MINUTES=5
BACKUP_RETENTION=14

# Plaintext credentials exist only in this temporary runtime directory while
# the official Atomic Mail CLI is actively using them. Default is the OS temp.
# ATOMICMAIL_RUNTIME_DIR=
