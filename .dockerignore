# Never copy operator secrets/state into the image context.
.git
.env
.env.*
data/
data-before-*/
secrets/
backups/
node_modules/
coverage/
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.patch
*.zip
npm-debug.log*
.DS_Store

# Defense in depth for accidentally copied plaintext credential state.
**/credentials/*/credentials.json
**/credentials/*/session.jwt
**/credentials/*/capability.jwt
